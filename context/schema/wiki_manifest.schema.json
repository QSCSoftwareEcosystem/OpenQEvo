{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/QSCSoftwareThrust/OpenQEvo/context/schema/wiki_manifest.schema.json",
  "title": "OpenQEvo Wiki Manifest",
  "description": "Persistent wiki maintenance contract for OpenQEvo context collections.",
  "type": "object",
  "required": ["version", "maintenance_rules", "collections"],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "maintenance_rules": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "collections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "raw_data", "key_points", "wiki", "selection_rules"],
        "properties": {
          "id": { "type": "string" },
          "raw_data": { "type": "string" },
          "key_points": { "type": "string" },
          "wiki": { "type": "string" },
          "selection_rules": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    }
  }
}
